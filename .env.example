# Chat Dev MCP runtime configuration
PORT=4100
HOST=localhost

# Optional tunnel credentials. Never commit real tokens.
NGROK_AUTHTOKEN=

# OpenAI Platform Organization Tunnels
OPENAI_TUNNEL_ID=
OPENAI_RUNTIME_KEY=
TUNNEL_MODE=dual

# Optional OAuth discovery. Leave unset for anonymous MCP usage through OpenAI Tunnel.
# If enabled, these URLs must be externally reachable HTTPS endpoints; the OpenAI
# tunnel does not automatically expose the authorization server.
MCP_OAUTH_AUTHORIZATION_SERVER_URL=
MCP_OAUTH_RESOURCE_URL=
